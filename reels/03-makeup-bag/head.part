<!doctype html>
<meta charset="utf-8">
<title>Kara Duo — Reel 03</title>
<link rel="stylesheet" href="fonts/fonts.css">
<style>html,body{margin:0;background:#2a1f30;height:100%}canvas{display:block;height:100vh;margin:auto}</style>
<canvas id="c" width="1080" height="1920"></canvas>
<script src="env.js"></script>
<script>
// Kara Duo · Reel 03 "مهمة الميكب آرتست" (makeup trolley bag) — every frame is a pure function of t (window.seek)
const W = 1080, H = 1920, DUR = 31.6;
const cv = document.getElementById('c'), g = cv.getContext('2d');

// ---------------- brand palette ----------------
const C = {
  ivory: '#FAF7F8', lav: '#D0B9D9', lavL: '#E7DAEC', lavLL: '#F3ECF6', lavD: '#A98BB5',
  mauve: '#654A70', mauveD: '#4F3859', mauveDD: '#3E2B47', ink: '#2B1C33',
  pink: '#DD4E94', pinkL: '#E98ABC', pinkLL: '#F3C3DC', pinkD: '#C93E82',
};

// ---------------- math ----------------
const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
const lerp = (a, b, k) => a + (b - a) * k;
const easeOut = (x) => 1 - Math.pow(1 - clamp(x), 3);
const easeIn = (x) => Math.pow(clamp(x), 3);
const easeInOut = (x) => { x = clamp(x); return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
function spring(t, k = 170, d = 26) {
  if (t <= 0) return 0;
  const w0 = Math.sqrt(k), z = d / (2 * w0);
  if (z < 1) { const wd = w0 * Math.sqrt(1 - z * z);
    return 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t)); }
  return 1 - Math.exp(-w0 * t) * (1 + w0 * t);
}
const SNAPPY = [320, 24], DEFAULT = [170, 22], HEAVY = [110, 18], PLAYFUL = [240, 13];
const sp = (t, preset = DEFAULT) => spring(t, preset[0], preset[1]);
function rng(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0;
  let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
  return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
function hex2rgb(h) { const n = parseInt(h.slice(1), 16); return [n >> 16 & 255, n >> 8 & 255, n & 255]; }
function mix(a, b, k) { const A = hex2rgb(a), B = hex2rgb(b); k = clamp(k);
  return `rgb(${A.map((v, i) => Math.round(lerp(v, B[i], k))).join(',')})`; }
const AR = (n) => String(n).replace(/[0-9]/g, (d) => '٠١٢٣٤٥٦٧٨٩'[d]);
const vis = (t, a, b) => t >= a && t < b;

// ---------------- assets ----------------
const IMG = {};
const PALETTES = ['07707f44', '4093547d', '7314f8ff', 'a5768f9c', 'a938f01b', 'b6722ef8', 'd754fed1', '85389240',
  'ec3f8d8c', 'ed15fa8d', '35da7493', '66da4d2b', '79580c51', 'd9d8e2f7', '1762cccf', '7096dce4', '24de4dfd'];
const HERO = '81c5cd68';
function loadImg(key, src) { return new Promise((res, rej) => { const i = new Image(); i.onload = () => { IMG[key] = i; res(); }; i.onerror = rej; i.src = src; }); }

// recolour the transparent logo to a solid colour (approved white-on-mauve version)
function tint(img, color) {
  const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
  const x = c.getContext('2d'); x.drawImage(img, 0, 0); x.globalCompositeOperation = 'source-in';
  x.fillStyle = color; x.fillRect(0, 0, c.width, c.height); return c;
}

// ---------------- pixel sprites ----------------
// fn(x, y) -> colour or null on a small grid; auto 1px dark outline; cached; drawn with nearest-neighbour
const SPR = new Map();
function sprite(key, w, h, fn, outline = C.ink) {
  if (SPR.has(key)) return SPR.get(key);
  const grid = [];
  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) grid[y * w + x] = fn(x, y);
  const c = document.createElement('canvas'); c.width = w + 2; c.height = h + 2;
  const x2 = c.getContext('2d');
  const at = (x, y) => (x < 0 || y < 0 || x >= w || y >= h) ? null : grid[y * w + x];
  if (outline) for (let y = -1; y <= h; y++) for (let x = -1; x <= w; x++)
    if (!at(x, y) && (at(x - 1, y) || at(x + 1, y) || at(x, y - 1) || at(x, y + 1))) { x2.fillStyle = outline; x2.fillRect(x + 1, y + 1, 1, 1); }
  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const col = at(x, y); if (col) { x2.fillStyle = col; x2.fillRect(x + 1, y + 1, 1, 1); } }
  SPR.set(key, c); return c;
}
// draw sprite anchored at (ax, ay) relative point (0..1) with pixel size s
function drawSpr(c, x, y, s, ax = 0.5, ay = 0.5, flip = false) {
  g.save(); g.imageSmoothingEnabled = false; g.translate(Math.round(x), Math.round(y));
  if (flip) g.scale(-1, 1);
  g.drawImage(c, -c.width * s * ax, -c.height * s * ay, c.width * s, c.height * s); g.restore();
}
const inEll = (x, y, cx, cy, rx, ry) => ((x + 0.5 - cx) / rx) ** 2 + ((y + 0.5 - cy) / ry) ** 2 <= 1;

// --- the host girl (placeholder until the brand character arrives) ---
function girl(eyes = 'open', mouth = 'closed') {
  return sprite(`girl:${eyes}:${mouth}`, 40, 46, (x, y) => {
    const cx = 19.5;
    const face = inEll(x, y, cx, 22.5, 9.6, 11) && y >= 12;
    const hij = inEll(x, y, cx, 20, 15.2, 19.5);
    const body = y >= 36 && Math.abs(x + 0.5 - cx) <= 12 + (y - 36) * 0.9;
    // eyes
    const eyeL = 15, eyeR = 23, ey = 21;
    const dx = eyes === 'side' ? -1 : eyes === 'sideR' ? 1 : 0;
    if (face) {
      if (eyes === 'blink') { if (y === ey + 2 && (x >= eyeL - 1 + dx && x <= eyeL + 1 + dx || x >= eyeR - 1 + dx && x <= eyeR + 1 + dx)) return C.ink; }
      else if (eyes === 'happy') {
        for (const ex of [eyeL, eyeR]) { if ((y === ey + 1 && (x === ex - 1 || x === ex + 2)) || (y === ey && (x === ex || x === ex + 1))) return C.ink; }
      } else {
        for (const ex of [eyeL + dx, eyeR + dx]) {
          if (x >= ex && x <= ex + 1 && y >= ey && y <= ey + 2) return (y === ey && x === ex + 1) ? '#FFFFFF' : '#3A2540';
          if (y === ey && x === ex - 1 && ex < cx) return C.ink;        // lash flick
          if (y === ey && x === ex + 2 && ex > cx) return C.ink;
        }
      }
      if (y === 18 && ((x >= 14 && x <= 17) || (x >= 22 && x <= 25))) return '#7A5560';               // brows
      if (y === 25 && (x === 13 || x === 14 || x === 25 || x === 26)) return C.pinkL;                   // cheeks
      if (y === 25 && (x === 19 || x === 20)) return '#E3AE90';                                         // nose
      // mouth
      if (mouth === 'closed' && y === 28 && x >= 18 && x <= 21) return C.pinkD;
      if (mouth === 'smile' && ((y === 28 && x >= 18 && x <= 21) || (y === 27 && (x === 17 || x === 22)))) return C.pinkD;
      if (mouth === 'open') { if (y === 27 && x >= 18 && x <= 21) return C.pinkD; if (y === 28 && x >= 18 && x <= 21) return '#7A2448'; if (y === 29 && x >= 19 && x <= 20) return C.pinkD; }
      if (mouth === 'o') { if ((y === 27 || y === 30) && x >= 19 && x <= 20) return C.pinkD; if ((y === 28 || y === 29) && (x === 18 || x === 21)) return C.pinkD; if ((y === 28 || y === 29) && x >= 19 && x <= 20) return '#7A2448'; }
      if (y <= 13) return C.lavLL;                                                                       // hijab band
      const edge = !inEll(x, y, cx, 22.5, 8.6, 10);
      return edge ? '#EDBF9F' : '#F6D4BA';
    }
    if (y >= 12 && y <= 14 && x === 29) return C.pink;                                                  // hijab pin
    if (y === 13 && (x === 28 || x === 30)) return C.pink;
    if (hij) {
      const nearFace = inEll(x, y, cx, 22.5, 11, 12.4);
      if (nearFace) return '#B593C2';
      return (x + y) % 9 === 0 && y > 4 ? '#C7A6D3' : '#CDAFD9';
    }
    if (body) return (x === 19 || x === 20) && y > 38 ? C.mauveD : '#4A3354';
    return null;
  });
}
// --- خزّوم: the Khuzama-flower mascot ---
function mascot(eyes = 'open') {
  return sprite(`m:${eyes}`, 30, 30, (x, y) => {
    const cx = 14.5, cy = 14.5, px = x + 0.5 - cx, py = y + 0.5 - cy;
    if (px * px + py * py <= 5.4 * 5.4) {                                    // face
      if (eyes === 'blink') { if (y === 15 && (x === 12 || x === 17)) return C.ink; }
      else if (eyes === 'wink') { if (y >= 13 && y <= 14 && x === 12) return C.ink; if (y === 14 && x >= 16 && x <= 18) return C.ink; }
      else if (y >= 13 && y <= 14 && (x === 12 || x === 17)) return C.ink;
      if (y === 17 && x >= 13 && x <= 16) return C.pinkD;
      if (y === 16 && (x === 10 || x === 19)) return C.pinkL;
      return C.ivory;
    }
    for (let k = 0; k < 4; k++) {                                            // four petals on the diagonals
      const a = Math.PI / 4 + k * Math.PI / 2, ca = Math.cos(a), sa = Math.sin(a);
      const u = px * ca + py * sa - 8.2, v = -px * sa + py * ca;
      if ((u / 6.6) ** 2 + (v / 4.4) ** 2 <= 1) {
        const pinkPetal = k % 2 === 1;
        if (Math.abs(v) < 0.6 && u > -3 && u < 4) return pinkPetal ? C.pinkLL : C.lavLL;   // vein
        return pinkPetal ? C.pinkL : C.lav;
      }
    }
    return null;
  });
}
// --- small icons ---
const sparkle = (col = C.pink, core = C.ivory) => sprite(`sp:${col}`, 9, 9, (x, y) => {
  const dx = Math.abs(x - 4), dy = Math.abs(y - 4);
  if (dx === 0 && dy === 0) return core;
  if ((dx === 0 && dy <= 4) || (dy === 0 && dx <= 4) || (dx <= 1 && dy <= 1)) return col; return null; }, null);
function star5(filled) {
  return sprite(`st:${filled}`, 13, 13, (x, y) => {
    const pts = []; for (let i = 0; i < 10; i++) { const r = i % 2 ? 2.8 : 6.4, a = -Math.PI / 2 + i * Math.PI / 5; pts.push([6.5 + r * Math.cos(a), 6.9 + r * Math.sin(a)]); }
    let inside = false; const px = x + 0.5, py = y + 0.5;
    for (let i = 0, j = 9; i < 10; j = i++) { const [xi, yi] = pts[i], [xj, yj] = pts[j];
      if ((yi > py) !== (yj > py) && px < (xj - xi) * (py - yi) / (yj - yi) + xi) inside = !inside; }
    if (!inside) return null; return filled ? (y < 5 ? C.pinkL : C.pink) : C.mauveD; });
}
const QBLOCK = ['..####..', '.##..##.', '.....##.', '....##..', '...##...', '...##...', '........', '...##...'];
const qblock = () => sprite('qb', 16, 16, (x, y) => {
  if (x === 0 || y === 0 || x === 15 || y === 15) return C.mauveDD;
  if ((x === 2 || x === 13) && (y === 2 || y === 13)) return C.lavD;
  const qx = x - 4, qy = y - 4; if (qx >= 0 && qx < 8 && qy >= 0 && qy < 8 && QBLOCK[qy][qx] === '#') return C.ivory;
  return y < 3 ? C.pinkL : C.pink; });
const sun = () => sprite('sun', 15, 15, (x, y) => { const dx = x - 7, dy = y - 7, r = Math.hypot(dx, dy);
  if (r <= 3.6) return '#F6C9A0'; if (r > 4.6 && r < 7.2 && (dx === 0 || dy === 0 || Math.abs(dx) === Math.abs(dy))) return C.pinkL; return null; });
const moon = () => sprite('moon', 13, 13, (x, y) => (Math.hypot(x - 6, y - 6) <= 5.6 && Math.hypot(x - 8.6, y - 4.4) > 4.4) ? C.ivory : null);
const HAND = ['....##......', '...#oo#.....', '...#oo#.....', '...#oo####..', '...#oo#oo#oo', '##.#oooooooo', '#o##oooooooo', '#oo#ooooooo#', '.#ooooooooo#', '..#oooooooo#', '...#oooooo#.', '....######..'];
const hand = () => sprite('hand', 12, 12, (x, y) => { const ch = HAND[y][x]; return ch === '#' ? C.ink : ch === 'o' ? C.ivory : null; }, null);
const mag = () => sprite('mag', 11, 11, (x, y) => { const r = Math.hypot(x - 4, y - 4);
  if (r >= 2.6 && r <= 4.2) return C.mauve; if (x - y === 0 && x >= 7 && x <= 10) return C.mauve; if (x - y === 1 && x >= 8 && x <= 10) return C.mauve; return null; }, null);
const flowerTile = () => sprite('fl', 16, 16, (x, y) => {
  const px = x + 0.5 - 8, py = y + 0.5 - 8; if (Math.abs(px) < 1.2 && Math.abs(py) < 1.2) return C.pink;
  for (let k = 0; k < 4; k++) { const a = Math.PI / 4 + k * Math.PI / 2, u = px * Math.cos(a) + py * Math.sin(a) - 4.2, v = -px * Math.sin(a) + py * Math.cos(a);
    if ((u / 3.6) ** 2 + (v / 2.3) ** 2 <= 1) return k % 2 ? '#C77BA8' : '#9E7FB0'; } return null; }, null);

// ---------------- the creator's avatar (cut from her character sheet) ----------------
const FACES = ['neutral', 'wink', 'laugh', 'oh', 'think', 'love', 'coffee', 'selfie'];
function drawAv(key, x, yb, s, { ax = 0.5, alpha = 1, rot = 0 } = {}) {      // anchored bottom-centre
  const im = IMG['av_' + key]; if (!im) return;
  g.save(); g.globalAlpha *= alpha; g.imageSmoothingEnabled = false; g.translate(Math.round(x), Math.round(yb)); g.rotate(rot);
  g.drawImage(im, -im.width * s * ax, -im.height * s, im.width * s, im.height * s); g.restore();
}
function bulb(x, y, s, t0, t) {                                             // pixel lightbulb with rays
  const k = sp(t - t0, PLAYFUL); if (k <= 0) return;
  const B = ['..####..', '.######.', '########', '########', '########', '.######.', '..####..', '..#--#..', '..####..', '...##...'];
  g.save(); g.translate(x, y); g.scale(k, k); const c = s;
  B.forEach((row, yy) => [...row].forEach((ch, xx) => { if (ch === '.') return; g.fillStyle = ch === '#' ? (yy < 7 ? (xx < 3 && yy < 4 ? '#FFF3C4' : '#F7C948') : C.lavD) : C.mauveDD; g.fillRect((xx - 4) * c, (yy - 5) * c, c, c); }));
  const pulse = 0.6 + 0.4 * Math.abs(Math.sin((t - t0) * 6));
  g.fillStyle = '#F7C948';
  for (let i = 0; i < 8; i++) { const a = -Math.PI / 2 + (i - 3.5) * 0.42; if (i === 0 || i === 7) continue;
    for (let j = 0; j < 2; j++) { const r = (7.2 + j * 1.6) * c * pulse + 4 * c; g.fillRect(Math.cos(a) * r - c / 2, Math.sin(a) * r - c * 1.5, c, c); } }
  g.restore();
}

// ---------------- pixel text (thresholded, upscaled) ----------------
const TXT = new Map();
function ptext(str, { size = 22, weight = 900, family = 'Cairo', color = C.ivory, shadow = null, shadowOff = 1, outline = null } = {}) {
  const key = [str, size, weight, family, color, shadow, outline].join('|');
  if (TXT.has(key)) return TXT.get(key);
  const font = `${weight} ${size}px "${family}"`;
  const m = document.createElement('canvas').getContext('2d'); m.font = font;
  const w = Math.ceil(m.measureText(str).width) + 6, h = Math.ceil(size * 1.9);
  const c = document.createElement('canvas'); c.width = w; c.height = h;
  const x = c.getContext('2d'); x.font = font; x.textBaseline = 'middle'; x.textAlign = 'center'; x.direction = /[\u0600-\u065F\u066E-\u06FF]/.test(str) ? 'rtl' : 'ltr';
  x.fillStyle = '#000'; x.fillText(str, w / 2, h / 2);
  const id = x.getImageData(0, 0, w, h), d = id.data, mask = new Uint8Array(w * h);
  for (let i = 0; i < w * h; i++) mask[i] = d[i * 4 + 3] > 110 ? 1 : 0;
  const out = x.createImageData(w, h), o = out.data;
  const put = (i, col) => { const [r, gg, b] = hex2rgb(col); o[i * 4] = r; o[i * 4 + 1] = gg; o[i * 4 + 2] = b; o[i * 4 + 3] = 255; };
  if (outline) for (let yy = 0; yy < h; yy++) for (let xx = 0; xx < w; xx++) { const i = yy * w + xx; if (mask[i]) continue;
    if ((xx > 0 && mask[i - 1]) || (xx < w - 1 && mask[i + 1]) || (yy > 0 && mask[i - w]) || (yy < h - 1 && mask[i + w])) put(i, outline); }
  if (shadow) for (let i = 0; i < w * h; i++) { const j = i - shadowOff * w - shadowOff; if (j >= 0 && mask[j] && !mask[i]) put(i, shadow); }
  for (let i = 0; i < w * h; i++) if (mask[i]) put(i, color);
  x.putImageData(out, 0, 0); TXT.set(key, c); return c;
}
function drawT(c, x, y, s, { ax = 0.5, ay = 0.5, rot = 0, sc = 1, alpha = 1 } = {}) {
  g.save(); g.globalAlpha *= alpha; g.imageSmoothingEnabled = false; g.translate(x, y); g.rotate(rot); g.scale(sc, sc);
  g.drawImage(c, -c.width * s * ax, -c.height * s * ay, c.width * s, c.height * s); g.restore();
}
// one line built word by word (RTL): words = [[text, time], ...]
function wordLine(t, words, cx, y, s, style, { pop = SNAPPY, gap = 0.28 } = {}) {
  const cs = words.map(([w]) => ptext(w, style)), sp0 = style.size * gap;
  const ws = cs.map((c) => c.width), total = ws.reduce((a, b) => a + b, 0) + sp0 * (cs.length - 1);
  let xr = cx + total * s / 2;                                   // start from the right edge
  cs.forEach((c, i) => {
    const k = sp(t - words[i][1], pop);
    if (k > 0.001) drawT(c, xr - ws[i] * s / 2, y + (1 - k) * 40, s, { sc: 0.6 + 0.4 * k, alpha: clamp(k * 3) });
    xr -= (ws[i] + sp0) * s;
  });
}
// clean (non-pixel) text
function text(str, x, y, { size = 60, weight = 800, family = 'Cairo', color = C.ivory, align = 'center', spacing = 0, alpha = 1 } = {}) {
  g.save(); g.globalAlpha *= alpha; g.font = `${weight} ${size}px "${family}"`; g.fillStyle = color; g.textAlign = align; g.textBaseline = 'middle';
  if (spacing) g.letterSpacing = spacing + 'px'; if (/[؀-ۿ]/.test(str)) g.direction = 'rtl'; g.fillText(str, x, y); g.restore();
}

// ---------------- pixel UI blocks ----------------
// stepped-corner panel with hard drop shadow
function panel(x, y, w, h, fill, { border = C.ink, bw = 6, step = 12, shadow = 'rgba(30,18,38,.45)', so = 12 } = {}) {
  const path = (ox, oy, ww, hh, st) => { g.beginPath(); g.moveTo(ox + st, oy); g.lineTo(ox + ww - st, oy); g.lineTo(ox + ww - st, oy + st / 2); g.lineTo(ox + ww - st / 2, oy + st / 2);
    g.lineTo(ox + ww - st / 2, oy + st); g.lineTo(ox + ww, oy + st); g.lineTo(ox + ww, oy + hh - st); g.lineTo(ox + ww - st / 2, oy + hh - st); g.lineTo(ox + ww - st / 2, oy + hh - st / 2);
    g.lineTo(ox + ww - st, oy + hh - st / 2); g.lineTo(ox + ww - st, oy + hh); g.lineTo(ox + st, oy + hh); g.lineTo(ox + st, oy + hh - st / 2); g.lineTo(ox + st / 2, oy + hh - st / 2);
    g.lineTo(ox + st / 2, oy + hh - st); g.lineTo(ox, oy + hh - st); g.lineTo(ox, oy + st); g.lineTo(ox + st / 2, oy + st); g.lineTo(ox + st / 2, oy + st / 2); g.lineTo(ox + st, oy + st / 2); g.closePath(); };
  if (shadow) { g.fillStyle = shadow; path(x + so, y + so, w, h, step); g.fill(); }
  if (border) { g.fillStyle = border; path(x, y, w, h, step); g.fill(); }
  g.fillStyle = fill; path(x + bw, y + bw, w - 2 * bw, h - 2 * bw, Math.max(0, step - bw)); g.fill();
}
// speech bubble with tail pointing to (tx, ty)
function bubble(cx, cy, w, h, tx, ty, fill = C.ivory) {
  g.save(); g.fillStyle = C.ink; g.beginPath();
  const bx = clamp(tx, cx - w / 2 + 40, cx + w / 2 - 80), by = cy + h / 2 - 4;
  g.moveTo(bx, by); g.lineTo(bx + 46, by); g.lineTo(tx, ty); g.closePath(); g.fill();
  g.fillStyle = fill; g.beginPath(); g.moveTo(bx + 8, by - 6); g.lineTo(bx + 38, by - 6); g.lineTo(tx + (bx + 23 - tx) * 0.22, ty - (ty - by) * 0.22); g.closePath(); g.fill();
  g.restore(); panel(cx - w / 2, cy - h / 2, w, h, fill, { so: 10 });
}
function pill(cx, cy, w, h, fill, border = C.ink) { panel(cx - w / 2, cy - h / 2, w, h, fill, { border, bw: 6, step: Math.min(h / 2, 24), so: 8 }); }

// ---------------- backgrounds & transitions ----------------
function bg(base, dot, drift = 0) {
  g.fillStyle = base; g.fillRect(0, 0, W, H);
  g.fillStyle = dot; const s = 48, off = drift % s;
  for (let y = -s; y < H + s; y += s) for (let x = 0; x < W + s; x += s) g.fillRect(x - off + 22, y + off * 0.5 + 22, 6, 6);
}
function gridBg(base, line) {
  g.fillStyle = base; g.fillRect(0, 0, W, H); g.fillStyle = line;
  for (let x = 0; x <= W; x += 60) g.fillRect(x, 0, 2, H); for (let y = 0; y <= H; y += 60) g.fillRect(0, y, W, 2);
}
// pixel block wipe centred on time tc (covers fully at tc)
function blockWipe(t, tc, color, dur = 0.34) {
  const k = 1 - Math.abs((t - tc) / (dur / 2)); if (k <= 0) return;
  const r = rng(99), B = 90;
  g.fillStyle = color;
  for (let y = 0; y < H; y += B) for (let x = 0; x < W; x += B) {
    const thr = (r() * 0.6 + (Math.abs(x - W / 2) / W + Math.abs(y - H / 2) / H) * 0.4);
    if (k > thr * 0.95) g.fillRect(x, y, B, B);
  }
}

// ---------------- camera shake (pure function of t) ----------------
const HITS = [[5.0, 14], [9.0, 10], [23.95, 12], [26.85, 8]];
function shake(t) { let x = 0, y = 0;
  for (const [th, a] of HITS) { const d = t - th; if (d < 0 || d > 0.5) continue; const e = a * Math.exp(-d * 12);
    x += e * Math.sin(d * 90 + th); y += e * Math.cos(d * 77 + th * 3); } return [x, y]; }

// ---------------- talking & blinking ----------------
function vo(t) { const e = window.VO_ENV || []; return e[Math.min(e.length - 1, Math.max(0, Math.floor(t * 60)))] || 0; }
function girlFace(t, eyesDefault, mouthDefault) {
  const v = vo(t), open = v > 0.16;
  const mouth = open ? (Math.floor(t * 14) % 3 === 0 ? 'o' : 'open') : mouthDefault;
  const blink = (t % 3.1) < 0.09 || (t > 12.9 && t < 12.98);
  return girl(blink ? 'blink' : eyesDefault, mouth);
}

