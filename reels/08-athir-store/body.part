    const s0 = 'الأثير الماسي لبيع الجولات'; const w0 = T(s0, x + w - 34, y + 186, { s: 28, w: 700, c: '#B0546A', f: 'Tajawal' });
    const k = eo(pr(t, V(44.3), 0.4)); ctx.fillStyle = '#E5566B'; ctx.fillRect(x + w - 34 - w0 * k, y + 186, w0 * k, 3);
    const ap = pop(t, V(44.8), 0.45, 12); withA(ap.a, () => { T('بعد', x + w - 34, y + 256 + ap.y, { s: 18, w: 700, c: '#9AA6B8', f: 'Tajawal' }); const w1 = T('الأثير الماسي لبيع الجوالات', x + w - 34, y + 302 + ap.y, { s: 30, w: 800, c: '#178A55', f: 'Tajawal' }); icon('check', x + w - 64 - w1, y + 302 + ap.y, 30, '#178A55', 4); });
