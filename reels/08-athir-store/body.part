    phone(480, 560, 360, 780, (x, y, w, h) => { ctx.save(); ctx.translate(x, y); ctx.scale(w / 330, w / 330); storeMobile(t, 330, h * 330 / w); ctx.restore(); }); ctx.restore(); });
  withA(eo(pr(t, 66.0, 0.6)), () => { wordmark(1780, 130, 44); T('شريك النمو الرقمي', 1520, 133, { s: 24, w: 500, c: C.mut, f: 'Tajawal' }); logo(1220, 132, 30 + 6 * pulse, { glow: pulse }); });
  const h = pop(t, 66.3, 0.6, 30);
