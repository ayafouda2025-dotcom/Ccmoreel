  const xs = [1590, 1150, 710, 270], ly = 450; ctx.fillStyle = 'rgba(255,255,255,0.12)'; ctx.fillRect(170, ly - 2, 1520, 4);
  let last = -1; WK.forEach((w, i) => { if (t >= w[0]) last = i; });
  if (last >= 0) { const f = (1590 - xs[last]) + 0 * eo(pr(t, WK[last][0], 0.4)); ctx.fillStyle = A.cyan; ctx.fillRect(1590 - f, ly - 2, f + 100, 4); }
  WK.forEach(([t0, wk, ti, ds], i) => { const p = pop(t, t0, 0.5, 24), x = xs[i], on = t >= t0, gr = i === 3; const b = back(pr(t, t0, 0.4));
    dia(x, ly, 24 * Math.max(0.55, b), on ? (gr ? A.royal : C.teal) : '#2A3B57'); if (on) dia(x, ly, 11 * b, A.cyan);
