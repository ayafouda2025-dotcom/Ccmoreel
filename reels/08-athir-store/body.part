    const v = Math.round(lerp(0, n, eo(pr(t, t0, 1.0)))); T(String(v), x, y - 10, { s: 120, w: 900, c: '#fff', al: 'center', f: 'Cairo' }); T(lbl, x, y + 110, { s: 28, w: 700, c: C.mut, al: 'center', f: 'Tajawal' }); ctx.restore(); }); });
