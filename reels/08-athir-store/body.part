    for (let i = 0; i < 5; i++) { const sp = back(pr(t, V(0.4) + i * 0.12, 0.3)); if (sp > 0) star(x + w - 352 - i * 44, y + 170, 18 * sp, '#F5B400'); }
    const nr = Math.round(lerp(0, 50, eo(pr(t, V(3.04), 1.1)))); withA(eo(pr(t, V(3.04), 0.3)), () => T(`(+${nr} تقييم)`, x + w - 590, y + 172, { s: 22, w: 700, c: '#6B7A90', f: 'Tajawal' }));
