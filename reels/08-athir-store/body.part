function card(x, y, w, h, o = {}) { ctx.save(); shadow(o.sb ?? 24, 8, 'rgba(15,27,46,0.10)'); RR(x, y, w, h, o.r || 20, o.bg || C.card); noShadow(); if (o.stroke) RR(x, y, w, h, o.r || 20, null, o.stroke, 2); ctx.restore(); }
function chip(xr, y, s, bgc, fg, o = {}) { const w = TW(s, { s: o.s || 20, w: 700, f: 'Tajawal' }) + 32; RR(xr - w, y - 18, w, 36, 18, bgc); T(s, xr - 16, y + 1, { s: o.s || 20, w: 700, c: fg, f: 'Tajawal' }); return w; }
function wrap(s, xr, y, maxw, lh, o) { const words = s.split(' '); let line = '', yy = y; for (const w of words) { const test = line ? line + ' ' + w : w; if (TW(test, o) > maxw && line) { T(line, xr, yy, o); line = w; yy += lh; } else line = test; } if (line) T(line, xr, yy, o); }
