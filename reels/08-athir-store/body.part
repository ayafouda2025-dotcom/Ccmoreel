  [[0.3, 0.3], [0.3, 0.72], [0.72, 0.5]].forEach(([u, v]) => { const x = -w / 2 + w * 0.08 + m * u, y = -h / 2 + w * 0.08 + m * v; ctx.beginPath(); ctx.arc(x, y, m * 0.17, 0, 7); ctx.fillStyle = '#1B1F27'; ctx.fill(); ctx.beginPath(); ctx.arc(x - m * 0.04, y - m * 0.04, m * 0.05, 0, 7); ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.fill(); });
