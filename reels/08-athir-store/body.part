// ================= timeline =================
const SC = [[0, 10.3, s1], [10.3, 16.7, s2], [16.7, 22.1, s3], [22.1, 32.3, s4], [32.3, 39.5, s5], [39.5, 45.5, s6], [45.5, 51.1, s7], [51.1, 54.5, s8], [54.5, 60.8, s9], [60.8, 65.7, s10], [65.7, DUR, s11]];
const TR = 0.7;
function draw(t) {
  ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.globalAlpha = 1; ctx.clearRect(0, 0, W, H);
  let i = SC.findIndex(([a, b]) => t >= a && t < b); if (i < 0) i = SC.length - 1;
  const [a, , fn] = SC[i];
  if (i > 0 && t < a + TR) {
    SC[i - 1][2](t);
    const p = eio(pr(t, a, TR)), s = p * 1500;
    const path = () => { ctx.beginPath(); ctx.moveTo(960, 540 - s); ctx.lineTo(960 + s * 1.2, 540); ctx.lineTo(960, 540 + s); ctx.lineTo(960 - s * 1.2, 540); ctx.closePath(); };
    ctx.save(); path(); ctx.clip(); fn(t); ctx.restore();
    ctx.save(); ctx.globalAlpha = Math.sin(p * Math.PI); ctx.strokeStyle = C.cyan; ctx.lineWidth = 5; path(); ctx.stroke(); ctx.restore();
  } else fn(t);
  const fo = Math.max(1 - pr(t, 0, 0.4), pr(t, DUR - 0.8, 0.8));
  if (fo > 0) { ctx.fillStyle = `rgba(7,13,24,${fo})`; ctx.fillRect(0, 0, W, H); }
}
window.__ready = false; window.seek = (t) => { draw(t); return true; };
(async () => {
  await new Promise((res) => { const im = new Image(); im.onload = () => { IMG.athir = im; res(); }; im.onerror = res; im.src = 'assets/athir_logo.png'; });
  await Promise.all(['900 40px Cairo', '800 40px Cairo', '700 40px Cairo', '500 40px Tajawal', '700 40px Tajawal', '800 40px Tajawal', '600 40px Montserrat', '500 40px Montserrat'].map((f) => document.fonts.load(f, 'abcأب')));
  await document.fonts.ready; window.__ready = true; draw(0);
})();
