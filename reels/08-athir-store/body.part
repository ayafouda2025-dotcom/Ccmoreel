  ctx.fillStyle = '#E9EDF2'; ctx.fillRect(x, y, w, 46); [['#FF5F57', 0], ['#FEBC2E', 1], ['#28C840', 2]].forEach(([c, i]) => { ctx.beginPath(); ctx.arc(x + 26 + i * 22, y + 23, 7, 0, 7); ctx.fillStyle = c; ctx.fill(); });
