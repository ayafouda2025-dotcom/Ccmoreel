    withA(eo(q), () => { const bw = 900, bx = 960 - bw / 2, by = 430; shadow(40, 14, 'rgba(0,0,0,0.5)'); RR(bx, by, bw, 92, 46, '#fff'); noShadow();
      const full = 'متجر الأثير الماسي أونلاين'; const n = Math.floor(full.length * cl((t - V(7.4)) / 0.9)); const txt = full.slice(0, n);
      T(txt + ((t * 2) % 1 < 0.5 ? '|' : ''), bx + bw - 90, by + 47, { s: 32, w: 600, c: A.deep, f: 'Tajawal' });
      ctx.beginPath(); ctx.arc(bx + bw - 48, by + 44, 14, 0, 7); ctx.strokeStyle = '#6B7A90'; ctx.lineWidth = 3; ctx.stroke(); ctx.beginPath(); ctx.moveTo(bx + bw - 38, by + 54); ctx.lineTo(bx + bw - 28, by + 64); ctx.stroke();
      const rp = pop(t, V(8.4), 0.45, 16); withA(rp.a, () => { RR(bx, by + 120 + rp.y, bw, 130, 24, 'rgba(255,255,255,0.06)', 'rgba(229,86,107,0.6)', 2); T('لا يوجد متجر إلكتروني', 960, by + 168 + rp.y, { s: 36, w: 800, c: '#FF8A9A', al: 'center' }); T('ولا موقع رسمي للطلب أونلاين', 960, by + 214 + rp.y, { s: 22, w: 500, c: C.mut, al: 'center', f: 'Tajawal' }); });
      T('؟', 960, 260, { s: 150, w: 900, c: A.cyan, al: 'center', a: eo(pr(t, V(7.7), 0.5)) }); });
  }
}
// S2 — customer goes to a competitor
