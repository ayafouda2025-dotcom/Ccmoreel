const IMG = {}; const LOGO_AR = 1182 / 943;
function athir(cx, cy, h, a = 1) { const im = IMG.athir; if (!im) return; withA(a, () => ctx.drawImage(im, cx - h * LOGO_AR / 2, cy - h / 2, h * LOGO_AR, h)); }

// drawn phone product (no brand marks)
function prodPhone(cx, cy, h, ca, cb, o = {}) {
  const w = h * 0.49; ctx.save(); ctx.translate(cx, cy); if (o.rot) ctx.rotate(o.rot);
  ctx.save(); shadow(h * 0.12, h * 0.05, 'rgba(10,30,60,0.28)');
