      T(wk, x + 170, ly + 110, { s: 24, w: 800, c: A.cyan }); T(ti, x + 170, ly + 170, { s: 44, w: 800 }); wrap(ds, x + 170, ly + 236, 340, 42, { s: 23, w: 500, c: '#B6C3D6', f: 'Tajawal' }); ctx.restore(); }); });
