    T('الأثير الماسي لبيع الجوالات', x + w - 228, y + 64, { s: 32, w: 800, c: A.deep }); T('محل جوالات وصيانة · المنفوحة، الرياض', x + w - 228, y + 108, { s: 20, w: 500, c: '#6B7A90', f: 'Tajawal' });
