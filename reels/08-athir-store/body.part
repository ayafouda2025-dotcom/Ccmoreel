    T('مفتوح حتى 12 منتصف الليل · فرعين في المنفوحة', x + w - 30, y + 270, { s: 21, w: 700, c: '#178A55', f: 'Tajawal' });
    const sp = pop(t, V(5.12), 0.45, 0); withA(sp.a, () => { ctx.save(); ctx.translate(x + 150, y + 270); ctx.scale(sp.s, sp.s); RR(-120, -24, 240, 48, 24, '#FFF4D6'); T('سمعة ممتازة ★', 0, 1, { s: 20, w: 800, c: '#A06A00', al: 'center', f: 'Tajawal' }); ctx.restore(); });
    ctx.restore(); });
