  ctx.strokeStyle = 'rgba(85,214,230,0.10)'; ctx.lineWidth = 3; for (let i = 0; i < 26; i++) { ctx.beginPath(); const y = r() * 1300 - 100; ctx.moveTo(-200, y); ctx.bezierCurveTo(600, y + (r() - 0.5) * 300, 1300, y + (r() - 0.5) * 300, 2200, y + (r() - 0.5) * 200); ctx.stroke(); }
  for (let i = 0; i < 20; i++) { ctx.beginPath(); const x = r() * 2200 - 100; ctx.moveTo(x, -100); ctx.bezierCurveTo(x + (r() - 0.5) * 300, 400, x + (r() - 0.5) * 300, 800, x + (r() - 0.5) * 200, 1300); ctx.stroke(); }
  ctx.strokeStyle = 'rgba(85,214,230,0.28)'; ctx.lineWidth = 9; ctx.beginPath(); ctx.moveTo(-100, 760); ctx.bezierCurveTo(500, 700, 1200, 820, 2100, 640); ctx.stroke(); ctx.beginPath(); ctx.moveTo(1180, -100); ctx.bezierCurveTo(1100, 400, 1250, 700, 1150, 1300); ctx.stroke();
  T('المنفوحة', 760, 470, { s: 30, w: 700, c: 'rgba(160,200,230,0.45)', f: 'Tajawal', al: 'center' }); T('الرياض', 1500, 260, { s: 34, w: 700, c: 'rgba(160,200,230,0.3)', f: 'Tajawal', al: 'center' });
  ctx.restore();
}
function pin(x, y, s, col, a = 1) { withA(a, () => { ctx.save(); ctx.translate(x, y); shadow(20, 8, 'rgba(0,0,0,0.4)'); ctx.beginPath(); ctx.moveTo(0, 0); ctx.bezierCurveTo(-s * 0.9, -s * 1.1, -s * 0.75, -s * 2.1, 0, -s * 2.1); ctx.bezierCurveTo(s * 0.75, -s * 2.1, s * 0.9, -s * 1.1, 0, 0); ctx.fillStyle = col; ctx.fill(); noShadow(); ctx.beginPath(); ctx.arc(0, -s * 1.38, s * 0.32, 0, 7); ctx.fillStyle = '#fff'; ctx.fill(); ctx.restore(); }); }
function s1(t) {
