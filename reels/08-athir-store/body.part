  ctx.globalCompositeOperation = 'source-atop'; ctx.fillStyle = sh; ctx.fillRect(-w / 2, -h / 2, w, h); ctx.restore();
}
const PRODS = [['iPhone 15 Pro', '256GB', '#8A857C', '#46433E', 0], ['Galaxy S24 Ultra', '512GB', '#3A3F4C', '#6B7183', 0], ['iPhone 13', 'مستعمل مفحوص', '#D9C9E6', '#A08ABF', 1], ['Redmi Note 13', '256GB', '#A6DCEB', '#4F9DB8', 0],
  ['Galaxy A55', '128GB', '#CBE8D7', '#6FAE8E', 0], ['iPhone 14', 'مستعمل مفحوص', '#F3D5DB', '#D597A6', 1], ['Pixel 8', '128GB', '#EFE9DC', '#B5AA95', 0], ['iPhone 15', '128GB', '#C3DBF2', '#6C9BCB', 0]];
const CATS = [['new', 'جوالات جديدة'], ['used', 'مستعملة مفحوصة'], ['audio', 'ساعات وسماعات'], ['charge', 'شواحن وكيابل'], ['case', 'كفرات وحماية'], ['fix', 'خدمات الصيانة']];
function catIcon(k, cx, cy, s, col, lw = 2.5) {
  ctx.save(); ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; const u = s / 2;
  if (k === 'new' || k === 'used') { ctx.beginPath(); ctx.roundRect(cx - u * 0.5, cy - u * 0.9, u, u * 1.8, u * 0.18); ctx.stroke(); if (k === 'new') { ctx.beginPath(); ctx.moveTo(cx + u * 0.75, cy - u * 0.95); ctx.lineTo(cx + u * 0.75, cy - u * 0.45); ctx.moveTo(cx + u * 0.5, cy - u * 0.7); ctx.lineTo(cx + u, cy - u * 0.7); ctx.stroke(); } else { ctx.beginPath(); ctx.moveTo(cx - u * 0.25, cy); ctx.lineTo(cx - u * 0.05, cy + u * 0.22); ctx.lineTo(cx + u * 0.28, cy - u * 0.2); ctx.stroke(); } }
  else if (k === 'audio') { ctx.beginPath(); ctx.arc(cx, cy, u * 0.7, Math.PI, 0); ctx.stroke(); ctx.beginPath(); ctx.roundRect(cx - u * 0.85, cy - u * 0.05, u * 0.38, u * 0.75, u * 0.12); ctx.roundRect(cx + u * 0.47, cy - u * 0.05, u * 0.38, u * 0.75, u * 0.12); ctx.fill(); }
  else if (k === 'charge') { ctx.beginPath(); ctx.moveTo(cx + u * 0.15, cy - u * 0.9); ctx.lineTo(cx - u * 0.45, cy + u * 0.1); ctx.lineTo(cx + u * 0.05, cy + u * 0.1); ctx.lineTo(cx - u * 0.15, cy + u * 0.9); ctx.lineTo(cx + u * 0.45, cy - u * 0.1); ctx.lineTo(cx - u * 0.05, cy - u * 0.1); ctx.closePath(); ctx.fill(); }
  else if (k === 'case') { icon('shield', cx, cy, s * 0.9, col, lw); }
  else if (k === 'fix') { ctx.beginPath(); ctx.moveTo(cx - u * 0.6, cy + u * 0.6); ctx.lineTo(cx + u * 0.2, cy - u * 0.2); ctx.stroke(); ctx.beginPath(); ctx.arc(cx + u * 0.38, cy - u * 0.38, u * 0.38, Math.PI * 0.25, Math.PI * 2.0); ctx.stroke(); }
  ctx.restore();
}
