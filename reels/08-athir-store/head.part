<!doctype html>
<html><head><meta charset="utf-8">
<link rel="stylesheet" href="fonts/fonts.css">
<style>html,body{margin:0;background:#0B1424}canvas{display:block}</style>
</head><body><canvas id="c" width="1920" height="1080"></canvas>
<script>
// TwinAI e-store proposal for مؤسسة الأثير الماسي — 1920x1080, window.seek(t) paints frame t
const W = 1920, H = 1080, DUR = 73.0;
const cv = document.getElementById('c'), ctx = cv.getContext('2d');
const A = { cyan: '#4EF2F3', blue: '#2276B4', royal: '#1A77E1', deep: '#0E2A47', sky: '#E8FBFC' };
const C = { bg: '#0B1424', bg2: '#0F1B2E', navy: '#0F1B2E', panel: '#16263F', teal: '#0E7C8C', teal2: '#12909F', tealD: '#0A5F6C', cyan: '#55D6E6',
  white: '#F3F6FA', mut: '#8C9BB2', mut2: '#5D6C84', cream: '#F4F1EA', app: '#F3F5F8', card: '#FFFFFF', ink: '#0F1B2E', ink2: '#45536A', line: '#E3E8EF',
  amber: '#B2702E', green: '#25D366', greenD: '#128C4A', red: '#E5566B', gold: '#F2B93B', bubble: '#E6F7F9' };

// ---- VO segments [src_start, src_end, dst_start] (audio/vo_a.mp3) ----
const SEG = [[0.05, 4.98, 0.6], [5.06, 8.98, 6.0], [9.20, 14.60, 10.6], [14.78, 19.34, 17.0], [19.50, 29.00, 22.4], [29.01, 35.50, 32.6],
  [35.50, 40.80, 39.8], [40.80, 45.74, 45.8], [45.74, 48.36, 51.4], [48.37, 53.90, 54.8], [53.90, 57.82, 61.1], [57.90, 61.40, 66.0]];
const V = (s) => { for (const [a, b, d] of SEG) if (s < b) return s >= a ? d + s - a : d - Math.min(0.3, a - s); const [a, , d] = SEG[SEG.length - 1]; return d + s - a; };

// ---- utils ----
const cl = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));
const pr = (t, a, d) => cl((t - a) / d);
const eo = (x) => 1 - Math.pow(1 - x, 3), eio = (x) => x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
const back = (x) => { const c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2); };
const lerp = (a, b, p) => a + (b - a) * p;
const AR = /[؀-ۿ]/;
function rng(s) { return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296); }

function T(s, x, y, o = {}) {
  ctx.save();
  ctx.font = `${o.w || 700} ${o.s || 40}px ${o.f || (AR.test(s) ? 'Cairo' : 'Montserrat')}`;
  ctx.fillStyle = o.c || C.white; ctx.globalAlpha *= (o.a ?? 1);
  ctx.textAlign = o.al || 'right'; ctx.textBaseline = o.bl || 'middle';
  ctx.direction = AR.test(s) && !o.ltr ? 'rtl' : 'ltr';
  if (o.ls) ctx.letterSpacing = o.ls + 'px';
  ctx.fillText(s, x, y); const w = ctx.measureText(s).width; ctx.restore(); return w;
}
function TW(s, o = {}) { ctx.save(); ctx.font = `${o.w || 700} ${o.s || 40}px ${o.f || (AR.test(s) ? 'Cairo' : 'Montserrat')}`; if (o.ls) ctx.letterSpacing = o.ls + 'px'; const w = ctx.measureText(s).width; ctx.restore(); return w; }
function RR(x, y, w, h, r, fill, stroke, lw = 2) { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); if (fill) { ctx.fillStyle = fill; ctx.fill(); } if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = lw; ctx.stroke(); } }
function shadow(b = 30, y = 12, c = 'rgba(5,12,25,0.35)') { ctx.shadowColor = c; ctx.shadowBlur = b; ctx.shadowOffsetY = y; }
function noShadow() { ctx.shadowColor = 'transparent'; ctx.shadowBlur = 0; ctx.shadowOffsetY = 0; }
function dia(cx, cy, s, fill, stroke, lw = 2) { ctx.beginPath(); ctx.moveTo(cx, cy - s); ctx.lineTo(cx + s, cy); ctx.lineTo(cx, cy + s); ctx.lineTo(cx - s, cy); ctx.closePath(); if (fill) { ctx.fillStyle = fill; ctx.fill(); } if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = lw; ctx.stroke(); } }
// pop-in helper: returns {a, y, s}
function pop(t, t0, d = 0.45, dy = 26) { const p = pr(t, t0, d); return { a: eo(p), y: (1 - eo(p)) * dy, s: lerp(0.92, 1, back(p)), p }; }
function withA(a, fn) { if (a <= 0.001) return; ctx.save(); ctx.globalAlpha *= a; fn(); ctx.restore(); }

// ---- brand pieces ----
function logo(cx, cy, s, o = {}) {
  const b = o.build ?? 1, glow = o.glow ?? 0;
  ctx.save();
  if (glow > 0) { const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, s * 2.2); g.addColorStop(0, `rgba(85,214,230,${0.35 * glow})`); g.addColorStop(1, 'rgba(85,214,230,0)'); ctx.fillStyle = g; ctx.fillRect(cx - s * 2.5, cy - s * 2.5, s * 5, s * 5); }
  // four facets flying in
  const facets = [[[0, -1], [1, 0], [0, 0], '#13A0B0', [1, -1]], [[1, 0], [0, 1], [0, 0], '#0E8696', [1, 1]], [[0, 1], [-1, 0], [0, 0], '#0A6371', [-1, 1]], [[-1, 0], [0, -1], [0, 0], '#0F7A89', [-1, -1]]];
  facets.forEach(([p1, p2, p3, col, dir], i) => {
    const q = eo(cl(b * 1.6 - i * 0.2)); const off = (1 - q) * s * 2.2, rot = (1 - q) * (i % 2 ? 0.8 : -0.8);
    ctx.save(); ctx.globalAlpha *= q; ctx.translate(cx + dir[0] * off, cy + dir[1] * off); ctx.rotate(rot);
    ctx.beginPath(); ctx.moveTo(p1[0] * s, p1[1] * s); ctx.lineTo(p2[0] * s, p2[1] * s); ctx.lineTo(p3[0] * s, p3[1] * s); ctx.closePath(); ctx.fillStyle = col; ctx.fill();
    ctx.restore();
  });
  const q2 = eo(pr(b, 0.6, 0.4));
  withA(q2, () => { dia(cx, cy, s * 0.6, null, 'rgba(120,225,236,0.55)', Math.max(1.5, s * 0.018)); });
  const q3 = back(pr(b, 0.75, 0.25));
  if (q3 > 0) dia(cx + s * 0.3, cy + s * 0.36, s * 0.32 * q3, C.cyan);
  ctx.restore();
}
function wordmark(xr, y, s, a = 1) { // right-aligned "◆ TwinAI" like the PDF header
  withA(a, () => { dia(xr - s * 0.32, y, s * 0.3, C.cyan); T('TwinAI', xr - s * 0.85, y + s * 0.04, { s, w: 600, f: 'Montserrat', al: 'right' }); });
}
function bg(t, o = {}) {
  ctx.fillStyle = o.dark ? '#070D18' : C.bg; ctx.fillRect(0, 0, W, H);
  const k = o.dark ? 0.55 : 1;
  let g = ctx.createRadialGradient(260 + Math.sin(t * 0.2) * 40, 90, 0, 260, 90, 950); g.addColorStop(0, `rgba(22,62,104,${0.6 * k})`); g.addColorStop(1, 'rgba(22,62,104,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  g = ctx.createRadialGradient(220, 1040, 0, 220, 1040, 720); g.addColorStop(0, `rgba(14,108,116,${0.55 * k})`); g.addColorStop(1, 'rgba(14,108,116,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  g = ctx.createRadialGradient(1750, 900, 0, 1750, 900, 600); g.addColorStop(0, `rgba(30,60,110,${0.25 * k})`); g.addColorStop(1, 'rgba(30,60,110,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  // faint dot grid
  ctx.fillStyle = 'rgba(140,170,210,0.06)';
  for (let x = 40; x < W; x += 48) for (let y = 40; y < H; y += 48) ctx.fillRect(x, y, 2, 2);
}
function eyebrow(s, xr, y, a = 1) { T(s, xr, y, { s: 30, w: 700, c: C.cyan, a }); }

// ---- icons (line style) ----
function icon(kind, cx, cy, s, col, lw = 3) {
  ctx.save(); ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  const u = s / 2;
  if (kind === 'chat') { ctx.beginPath(); ctx.roundRect(cx - u, cy - u * 0.8, u * 2, u * 1.4, u * 0.35); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - u * 0.4, cy + u * 0.6); ctx.lineTo(cx - u * 0.7, cy + u); ctx.lineTo(cx - u * 0.05, cy + u * 0.6); ctx.stroke(); for (let i = -1; i <= 1; i++) { ctx.beginPath(); ctx.arc(cx + i * u * 0.45, cy - u * 0.1, lw * 0.6, 0, 7); ctx.fill(); } }
  else if (kind === 'bot') { ctx.beginPath(); ctx.roundRect(cx - u * 0.85, cy - u * 0.5, u * 1.7, u * 1.3, u * 0.35); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx, cy - u * 0.5); ctx.lineTo(cx, cy - u * 0.9); ctx.stroke(); ctx.beginPath(); ctx.arc(cx, cy - u * 0.98, lw, 0, 7); ctx.fill(); ctx.beginPath(); ctx.arc(cx - u * 0.38, cy + u * 0.1, lw * 1.1, 0, 7); ctx.arc(cx + u * 0.38, cy + u * 0.1, lw * 1.1, 0, 7); ctx.fill(); }
  else if (kind === 'device') { ctx.beginPath(); ctx.roundRect(cx - u * 0.55, cy - u, u * 1.1, u * 2, u * 0.2); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - u * 0.15, cy + u * 0.72); ctx.lineTo(cx + u * 0.15, cy + u * 0.72); ctx.stroke(); }
  else if (kind === 'call') { ctx.translate(cx, cy); ctx.rotate(-Math.PI / 4); ctx.lineWidth = Math.max(lw, u * 0.28); ctx.beginPath(); ctx.arc(0, 0, u * 0.62, Math.PI * 0.72, Math.PI * 1.28); ctx.stroke(); for (const a of [0.7, 1.3]) { ctx.beginPath(); ctx.ellipse(Math.cos(Math.PI * a) * u * 0.62, Math.sin(Math.PI * a) * u * 0.62, u * 0.2, u * 0.3, Math.PI * a + Math.PI / 2, 0, 7); ctx.fill(); } }
  else if (kind === 'alert') { ctx.beginPath(); ctx.moveTo(cx, cy - u); ctx.lineTo(cx + u, cy + u * 0.8); ctx.lineTo(cx - u, cy + u * 0.8); ctx.closePath(); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx, cy - u * 0.3); ctx.lineTo(cx, cy + u * 0.2); ctx.stroke(); ctx.beginPath(); ctx.arc(cx, cy + u * 0.5, lw * 0.7, 0, 7); ctx.fill(); }
  else if (kind === 'cal') { ctx.beginPath(); ctx.roundRect(cx - u, cy - u * 0.75, u * 2, u * 1.75, u * 0.2); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - u, cy - u * 0.25); ctx.lineTo(cx + u, cy - u * 0.25); ctx.stroke(); for (const dx of [-0.45, 0.45]) { ctx.beginPath(); ctx.moveTo(cx + dx * u, cy - u); ctx.lineTo(cx + dx * u, cy - u * 0.55); ctx.stroke(); } for (let i = 0; i < 3; i++) for (let j = 0; j < 2; j++) { ctx.fillRect(cx - u * 0.55 + i * u * 0.5, cy + u * 0.1 + j * u * 0.4, lw, lw); } }
  else if (kind === 'branch') { const pts = [[0, -0.7], [-0.75, 0.6], [0.75, 0.6]]; ctx.beginPath(); ctx.moveTo(cx, cy - u * 0.7); ctx.lineTo(cx - u * 0.75, cy + u * 0.6); ctx.moveTo(cx, cy - u * 0.7); ctx.lineTo(cx + u * 0.75, cy + u * 0.6); ctx.stroke(); for (const [a, b] of pts) { ctx.beginPath(); ctx.arc(cx + a * u, cy + b * u, u * 0.28, 0, 7); ctx.fill(); } }
  else if (kind === 'chart') { [[-0.7, 0.3], [-0.1, -0.3], [0.5, -0.8]].forEach(([x, top]) => { ctx.fillRect(cx + x * u, cy + top * u, u * 0.4, (1 - top) * u - u * 0.1); }); }
  else if (kind === 'shield') { ctx.beginPath(); ctx.moveTo(cx, cy - u); ctx.lineTo(cx + u * 0.85, cy - u * 0.6); ctx.lineTo(cx + u * 0.8, cy + u * 0.1); ctx.quadraticCurveTo(cx + u * 0.6, cy + u * 0.75, cx, cy + u); ctx.quadraticCurveTo(cx - u * 0.6, cy + u * 0.75, cx - u * 0.8, cy + u * 0.1); ctx.lineTo(cx - u * 0.85, cy - u * 0.6); ctx.closePath(); ctx.stroke(); }
  else if (kind === 'check') { ctx.beginPath(); ctx.moveTo(cx - u * 0.6, cy); ctx.lineTo(cx - u * 0.15, cy + u * 0.45); ctx.lineTo(cx + u * 0.65, cy - u * 0.45); ctx.stroke(); }
  else if (kind === 'bell') { ctx.beginPath(); ctx.moveTo(cx - u * 0.75, cy + u * 0.5); ctx.quadraticCurveTo(cx - u * 0.6, cy + u * 0.3, cx - u * 0.6, cy - u * 0.1); ctx.arc(cx, cy - u * 0.1, u * 0.6, Math.PI, 0); ctx.quadraticCurveTo(cx + u * 0.6, cy + u * 0.3, cx + u * 0.75, cy + u * 0.5); ctx.closePath(); ctx.stroke(); ctx.beginPath(); ctx.arc(cx, cy + u * 0.72, u * 0.16, 0, 7); ctx.fill(); }
  else if (kind === 'globe') { ctx.beginPath(); ctx.arc(cx, cy, u * 0.9, 0, 7); ctx.stroke(); ctx.beginPath(); ctx.ellipse(cx, cy, u * 0.4, u * 0.9, 0, 0, 7); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - u * 0.9, cy); ctx.lineTo(cx + u * 0.9, cy); ctx.stroke(); }
  else if (kind === 'lock') { ctx.beginPath(); ctx.roundRect(cx - u * 0.7, cy - u * 0.1, u * 1.4, u * 1.05, u * 0.15); ctx.fill(); ctx.beginPath(); ctx.arc(cx, cy - u * 0.15, u * 0.45, Math.PI, 0); ctx.stroke(); }
  else if (kind === 'star') { star(cx, cy, u, col); }
  else if (kind === 'moon') { ctx.beginPath(); ctx.arc(cx, cy, u * 0.8, 0, 7); ctx.fill(); ctx.globalCompositeOperation = 'destination-out'; ctx.beginPath(); ctx.arc(cx + u * 0.4, cy - u * 0.3, u * 0.7, 0, 7); ctx.fill(); }
  ctx.restore();
}
function star(cx, cy, r, col, stroke) { ctx.beginPath(); for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? r * 0.45 : r; ctx.lineTo(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr); } ctx.closePath(); if (stroke) { ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.stroke(); } else { ctx.fillStyle = col; ctx.fill(); } }
function waIcon(cx, cy, r) { ctx.beginPath(); ctx.arc(cx, cy, r, 0, 7); ctx.fillStyle = C.green; ctx.fill(); icon('call', cx + r * 0.05, cy + r * 0.05, r * 1.0, '#fff', Math.max(1.5, r * 0.12)); }

// ---- phone mockup ----
function phone(cx, cy, w, h, fn, o = {}) {
  ctx.save(); shadow(60, 24, 'rgba(0,0,0,0.5)');
  RR(cx - w / 2, cy - h / 2, w, h, w * 0.13, '#05080F'); noShadow();
  RR(cx - w / 2, cy - h / 2, w, h, w * 0.13, null, '#2B3B57', 3);
  const ix = cx - w / 2 + 12, iy = cy - h / 2 + 12, iw = w - 24, ih = h - 24;
  ctx.save(); ctx.beginPath(); ctx.roundRect(ix, iy, iw, ih, w * 0.11); ctx.clip(); fn(ix, iy, iw, ih); ctx.restore();
  RR(cx - w * 0.15, iy + 12, w * 0.3, 26, 13, '#05080F');
  ctx.restore();
}
function notif(x, y, w, title, body, time, a = 1, o = {}) { // phone-style notification card (x,y = top-left)
  withA(a, () => {
    ctx.save(); shadow(20, 8, 'rgba(0,0,0,0.25)'); RR(x, y, w, o.h || 108, 22, o.bg || 'rgba(245,248,252,0.96)'); noShadow(); ctx.restore();
    waIcon(x + w - 40, y + 38, 20);
    T(title, x + w - 72, y + 36, { s: 22, w: 800, c: C.ink, f: 'Tajawal' });
    T(time, x + 20, y + 36, { s: 18, w: 500, c: C.mut2, al: 'left', f: 'Tajawal' });
    T(body, x + w - 24, y + 74, { s: 22, w: 500, c: C.ink2, f: 'Tajawal' });
  });
}

