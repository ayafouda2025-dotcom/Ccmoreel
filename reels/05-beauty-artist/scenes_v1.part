// ---------- reel 05: "اكملي المجموعة" — the 57-piece Beauty Artist bag as a collection game ----------
const FACES5 = ['neutral', 'content', 'laugh', 'wink', 'think', 'love', 'drink', 'cool'];
const PRODS = ['1762cccf', '7096dce4', '81c5cd68', '66da4d2b', 'a42d1681', '299c778a', '9b922240', 'b817a335', '46a8fb5d', '12c8e6d9', 'ef804147'];
const GX = 150, GY = 560, GC = 7, GR = 9, CELL = 112;            // 7 x 9 = 63 slots, 57 used
const slot = (i) => [GX + (GC - 1 - (i % GC)) * CELL + CELL / 2, GY + Math.floor(i / GC) * CELL + CELL / 2];   // RTL fill order

function inventory(t, filled, { alpha = 1, glow = 0 } = {}) {
  g.save(); g.globalAlpha *= alpha;
  panel(GX - 30, GY - 30, GC * CELL + 60, GR * CELL + 60, C.mauveDD, { so: 14 });
  for (let i = 0; i < GC * GR; i++) {
    const [x, y] = slot(i), used = i < 57, on = i < filled;
    g.fillStyle = C.ink; g.fillRect(x - 48, y - 48, 96, 96);
    g.fillStyle = !used ? '#3A2944' : on ? C.lav : C.mauve; g.fillRect(x - 44, y - 44, 88, 88);
    if (on) { const id = PRODS[i % PRODS.length], im = IMG[id]; if (im) { const s = Math.min(76 / im.width, 76 / im.height); g.imageSmoothingEnabled = true; g.drawImage(im, x - im.width * s / 2, y - im.height * s / 2, im.width * s, im.height * s); } }
    if (on && glow > 0) { g.fillStyle = `rgba(255,255,255,${glow * 0.5})`; g.fillRect(x - 44, y - 44, 88, 88); }
  }
  g.restore();
}
function counter(n, x, y, s, k = 1) {
  drawT(ptext(`${AR(n)}/${AR(57)}`, { size: 22, color: '#F7C948', shadow: C.ink, shadowOff: 2 }), x, y, s, { sc: k });
}
function statCard(cx, cy, w, label, count, img, k, col) {
  if (k <= 0) return;
  g.save(); g.translate(cx, cy); g.scale(0.5 + 0.5 * k, 0.5 + 0.5 * k); g.globalAlpha *= clamp(k * 3);
  panel(-w / 2, -110, w, 220, C.ivory, { so: 10 });
  g.fillStyle = col; g.fillRect(w / 2 - 22, -104, 16, 208);
  if (img && IMG[img]) { const im = IMG[img], s = Math.min(170 / im.width, 170 / im.height); g.imageSmoothingEnabled = true; g.drawImage(im, -w / 2 + 25 + (170 - im.width * s) / 2, -im.height * s / 2, im.width * s, im.height * s); }
  else { for (let i = 0; i < 3; i++) drawSpr(sparkle(i % 2 ? C.lavD : C.pink), -w / 2 + 70 + i * 45, (i % 2 ? 20 : -20), 6); }
  text(label, w / 2 - 45, -30, { size: 44, weight: 800, color: C.mauve, align: 'right', maxW: w - 250 });
  drawT(ptext(`×${AR(count)}`, { size: 20, color: C.pink }), w / 2 - 110, 50, 4);
  g.restore();
}

// ---------- host: one fixed expression per scene (bottom-left) ----------
const HOST = [[3.6, 'laugh'], [6.3, 'cool'], [13.9, 'love']];
function drawHost(t) {
  if (t < 3.6 || t >= 18.3) return;
  let face = HOST[0][1], t0 = HOST[0][0]; for (const [a, f] of HOST) if (t >= a) { face = f; t0 = a; }
  const k = sp(t - 3.6, PLAYFUL), pop = t0 > 3.6 ? 1 + 0.08 * Math.exp(-(t - t0) * 9) * Math.sin(Math.min(Math.PI, (t - t0) * 14)) : 1;
  drawAv('face_' + face, 150, 1935 + (1 - k) * 320 + Math.sin(t * 4.2) * 4, 1.45 * pop);
}

// -------- S1 opening 0–3.6: an empty 57-slot collection book + her, thinking --------
function sOpen(t) {
  space(t, C.mauveDD);
  const lk = sp(t - 0.05, SNAPPY);
  if (lk > 0) { const L = IMG.logoW, w = 420 * (0.7 + 0.3 * lk), h = w * L.height / L.width; g.save(); g.globalAlpha = clamp(lk * 2); g.drawImage(L, W / 2 - w / 2, 230 - h / 2, w, h); g.restore(); }
  const ik = sp(t - 0.15, [200, 18]);
  g.save(); g.translate(540, 1060); g.scale(0.8 + 0.2 * ik, 0.8 + 0.2 * ik); g.translate(-540, -1060); inventory(t, 0, { alpha: clamp(ik * 3) }); g.restore();
  // "?" blinks in every empty slot, in a wave
  for (let i = 0; i < 57; i++) { const [x, y] = slot(i), d = t - 0.4 - i * 0.012; if (d > 0 && Math.sin(t * 6 + i) > 0.2) drawT(ptext('؟', { size: 14, color: C.lavD }), x, y - 4, 3.4, { sc: clamp(d * 5) }); }
  wordLine(t, [['تخيلي…', 0.3], ['مكياجك', 1.35], ['كله', 2.05]], W / 2, 360, 3.9, { size: 22, color: C.ivory, shadow: C.pink, shadowOff: 2 });
  if (t > 2.5) wordLine(t, [['في', 2.55], ['شنطة', 2.7], ['وحدة!', 3.0]], W / 2, 470, 4.6, { size: 22, color: C.pinkL, shadow: C.ink, shadowOff: 2 });
  const bk = sp(t - 0.2, [180, 20]), out = easeIn((t - 3.35) / 0.25);
  drawAv('bust', 700, 1960 + (1 - bk) * 300 + out * 1100 + Math.sin(t * 3) * 6, 1.2);
}

// -------- S2 3.6–6.3: real products rain into the slots, counter to 57 --------
function sFill(t) {
  space(t, C.mauveDD);
  const T0 = 3.75, n = Math.min(57, Math.floor(clamp((t - T0) / 2.0) * 57));
  inventory(t, n, { glow: t > 5.8 ? Math.max(0, Math.sin((t - 5.8) * 20)) * 0.6 : 0 });
  // the next few items are falling into their slots
  for (let i = n; i < Math.min(57, n + 6); i++) { const ti = T0 + i / 57 * 2.0, d = (ti - t) / 0.35; if (d < 0 || d > 1) continue;
    const [x, y] = slot(i), id = PRODS[i % PRODS.length], im = IMG[id]; if (!im) continue; const s = Math.min(150 / im.width, 150 / im.height) * (1 + d);
    g.save(); g.globalAlpha = 1 - d * 0.3; g.drawImage(im, x - im.width * s / 2, y - 700 * d - im.height * s / 2, im.width * s, im.height * s); g.restore(); }
  const ck = sp(t - 3.7, SNAPPY);
  counter(n, 540, 400, 5.2, 0.8 + 0.2 * ck);
  if (t > 4.5) wordLine(t, [['قطعة', 4.6], ['من', 4.95], ['كارا', 5.1], ['دو', 5.35]], W / 2, 260, 4.2, { size: 22, color: C.ivory, shadow: C.pink, shadowOff: 2 });
  if (n >= 57) { const k = sp(t - 5.8, PLAYFUL); drawT(ptext('COMPLETE!', { size: 14, weight: 400, family: 'Press Start 2P', color: '#F7C948', outline: C.ink }), 540, 1640, 5, { sc: k, rot: -0.05 }); }
}

// -------- S3 6.3–13.9: what's inside, category by category (real product photos) --------
const CATS = [
  ['باليتات', 7, '1762cccf', 6.75, C.pink],
  ['إضاءة', 18, 'tube_gold', 9.15, '#D9A93A'],
  ['كونتور وبلاشر', 12, '299c778a', 9.75, '#B0703F'],
  ['شفايف', 6, 'ef804147', 11.0, C.pinkD],
  ['تحضير وتثبيت', 8, null, 12.1, C.lavD],
  ['عيون وحواجب', 5, 'b817a335', 12.6, C.mauve],
];
function sCats(t) {
  space(t, C.mauve);
  drawT(ptext('INSIDE THE BAG', { size: 10, weight: 400, family: 'Press Start 2P', color: '#F7C948', outline: C.ink }), 540, 250, 4.6, { sc: sp(t - 6.35, SNAPPY) });
  CATS.forEach(([lab, cnt, img, ti], i) => {
    const k = sp(t - ti, PLAYFUL), x = i % 2 ? 285 : 795, y = 480 + Math.floor(i / 2) * 270;
    statCard(lerp(x + (i % 2 ? -400 : 400), x, clamp(k * 1.2)), y, 490, lab, cnt, img, k, CATS[i][4]);
  });
  // running total
  let total = 0; CATS.forEach(([, c, , ti]) => { if (t >= ti) total += c; }); if (t >= 13.0) total = 57;
  const tk = sp(t - 6.8, SNAPPY);
  if (tk > 0) { g.save(); g.translate(600, 1330); g.scale(tk, tk); pill(0, 0, 640, 130, C.ink, C.ink); drawT(ptext('المجموع', { size: 16, color: C.lavL }), 190, -2, 3.6); counter(total, -110, 0, 3.6); g.restore(); }
  const bk = sp(t - 13.0, PLAYFUL); if (bk > 0) { g.save(); g.translate(250, 1220); g.rotate(-0.06); g.scale(bk, bk); pill(0, 0, 330, 88, C.pink); drawT(ptext('+ فرشاة ×١', { size: 15, color: C.ivory }), 0, -2, 3.4); g.restore(); }
  if (t > 12.1) wordLine(t, [['من', 12.0], ['البرايمر', 12.15], ['لين', 12.85], ['التثبيت!', 13.1]], 600, 1500, 3.8, { size: 22, color: C.ivory, shadow: C.pink, shadowOff: 2 });
}

// -------- S4 13.9–18.3: the real bag — wheels, opens, dividers, 4 clear pouches --------
function sBag(t) {
  space(t, C.mauveDD);
  const rk = sp(t - 13.95, [120, 15]), open = clamp((t - 15.9) / 0.35);
  if (open < 1) { g.save(); g.globalAlpha = 1 - open; g.fillStyle = 'rgba(20,10,28,.45)'; g.beginPath(); g.ellipse(lerp(1500, 540, rk), 1310, 290, 32, 0, 0, Math.PI * 2); g.fill();
    photo('bagc', lerp(1500, 540, rk), 1020, 620, { rot: (1 - rk) * -0.1, shadow: false }); g.restore(); }
  if (open > 0) { const k = sp(t - 15.9, [160, 16]); photo('bago', 540, 1010, 640 * (0.85 + 0.15 * k), { alpha: open }); }
  wordLine(t, [['وكلها', 14.1], ['مرتبة', 14.55]], W / 2, 330, 5, { size: 22, color: C.ivory, shadow: C.pink, shadowOff: 2 });
  // callouts
  const cw = sp(t - 15.5, PLAYFUL);
  if (cw > 0 && open < 0.5) { g.save(); g.translate(830, 1450); g.scale(cw, cw); g.beginPath(); g.arc(0, 0, 150, 0, Math.PI * 2); g.fillStyle = C.ink; g.fill(); g.beginPath(); g.arc(0, 0, 140, 0, Math.PI * 2); g.clip();
    const im = IMG.wheel; g.drawImage(im, -150, -170, 300, 300 * im.height / im.width); g.restore(); pill(830, 1640, 300, 90, C.pink); drawT(ptext('عجلات', { size: 16, color: C.ivory }), 830, 1638, 3.6); }
  const ck = sp(t - 16.25, PLAYFUL); if (ck > 0) { g.save(); g.translate(270, 640); g.rotate(-0.05); g.scale(ck, ck); pill(0, 0, 300, 96, C.pink); drawT(ptext('فواصل', { size: 16, color: C.ivory }), 0, -2, 3.6); g.restore(); }
  const pk = sp(t - 17.2, PLAYFUL); if (pk > 0) { g.save(); g.translate(800, 640); g.rotate(0.05); g.scale(pk, pk); pill(0, 0, 400, 96, C.mauveD); drawT(ptext('٤ شنط شفافة', { size: 16, color: C.ivory }), 0, -2, 3.6); g.restore(); }
}

// -------- S5 18.3–22.4: character select — who is it for --------
const WHO = [['الميكب آرتست', 'cool', 18.55], ['العروس', 'love', 19.7], ['المبتدئة', 'content', 20.7]];
function sWho(t) {
  space(t, C.mauve);
  drawT(ptext('SELECT PLAYER', { size: 11, weight: 400, family: 'Press Start 2P', color: '#F7C948', outline: C.ink }), 540, 330, 4.6, { sc: sp(t - 18.35, SNAPPY) });
  let sel = -1; WHO.forEach(([, , ti], i) => { if (t >= ti) sel = i; });
  WHO.forEach(([lab, face, ti], i) => {
    const k = sp(t - ti, PLAYFUL); if (k <= 0) return;
    const x = 850 - i * 310, y = 1000, on = i === sel;
    g.save(); g.translate(x, y + (on ? -20 : 0)); g.scale((0.6 + 0.4 * k) * 1.08, (0.6 + 0.4 * k) * 1.08);
    panel(-135, -230, 270, 460, on ? C.pinkLL : C.lavLL, { border: on ? C.pink : C.ink, bw: on ? 10 : 6, so: 12 });
    g.save(); g.beginPath(); g.rect(-125, -220, 250, 330); g.clip(); drawAv('face_' + face, 0, 115, 1.75); g.restore();
    text(lab, 0, 170, { size: lab.length > 8 ? 34 : 42, weight: 800, color: C.mauve, maxW: 240 });
    g.restore();
    if (on) drawSpr(hand(), x + 60, y + 250 + Math.sin(t * 8) * 6, 6, 0.2, 0.05);
  });
  wordLine(t, [['ولو', 20.65], ['تبين', 20.9], ['تبدين', 21.2], ['من', 21.45], ['الصفر', 21.55]], W / 2, 1420, 3.8, { size: 22, color: C.ivory, shadow: C.pink, shadowOff: 2 });
  drawT(ptext('ALL PLAYERS ✓', { size: 9, weight: 400, family: 'Press Start 2P', color: C.lavL }), 540, 1600, 3.6, { sc: sp(t - 21.6, SNAPPY) });
}

// -------- S6 22.4–29.6 ending: COLLECTION COMPLETE, the full open bag on a glowing pedestal --------
// -------- S8 how to order 22.40–32.6 (real store screens, prices hidden) --------
const OSTEPS = [['karaduo.com', 22.65], ['البكجات', 24.80], ['أضيفيها للسلة', 25.95], ['توصلك لين بابك', 27.40]];
function phone(cx, top, w, key, cropH = null) {
  const im = IMG[key], s = w / im.width, h = 932 * 2 * s;
  panel(cx - w / 2 - 22, top - 22, w + 44, h + 44, C.ink, { border: C.ink, so: 16, step: 30 });
  g.save(); g.beginPath(); g.rect(cx - w / 2, top, w, h); g.clip(); g.fillStyle = '#F3ECF6'; g.fillRect(cx - w / 2, top, w, h);
  g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high'; const sh = cropH || im.height;
  g.drawImage(im, 0, 0, im.width, sh, cx - w / 2, top, w, sh * s); g.restore();
  return { s, x0: cx - w / 2, y0: top };
}
function tapAt(x, y, t, ti) { const d = t - ti; if (d < -0.45 || d > 0.6) return;
  const k = easeOut((d + 0.45) / 0.45); drawSpr(hand(), lerp(x + 260, x, k), lerp(y + 300, y, k), 7, 0.2, 0.05);
  if (d > 0 && d < 0.45) { g.strokeStyle = C.pink; g.lineWidth = 8 * (1 - d / 0.45); g.beginPath(); g.arc(x, y, 20 + d * 160, 0, Math.PI * 2); g.stroke(); } }
function sOrder(t) {
  // a different look from reel 02: a pixel "quest log" on the left of the phone
  gridBg(C.lavLL, C.lavL);
  const pk = sp(t - 22.45, DEFAULT), top = 330 + (1 - pk) * 1500, w = 470;
  let key = 'o_home', crop = null;
  if (t >= 25.15 && t < 25.80) key = 'o_bundles'; else if (t >= 25.80 && t < 26.25) { key = 'o_product'; crop = 1600; } else if (t >= 26.25) key = 'o_add';
  const ph = phone(700, top, w, key, crop), X = (x) => ph.x0 + x * 2 * ph.s, Y = (y) => ph.y0 + y * 2 * ph.s;
  if (key === 'o_home') tapAt(X(350), Y(625), t, 24.95);
  if (key === 'o_bundles') tapAt(X(315), Y(300), t, 25.60);
  if (key === 'o_add') tapAt(X(215), Y(465), t, 26.50);
  if (t > 26.55) { const k = sp(t - 26.55, PLAYFUL); g.save(); g.translate(700, top + 200); g.scale(k, k); pill(0, 0, 440, 100, C.mauveDD); drawT(ptext('أُضيفت للسلة', { size: 16, color: C.ivory }), 0, -2, 3.6); g.restore(); }
  // quest log (RTL list, checks fill as she says each step)
  const qk = sp(t - 22.60, SNAPPY);
  g.save(); g.translate((1 - qk) * -500, 0);
  panel(30, 360, 400, 640, C.ivory, { so: 12 });
  g.fillStyle = C.pink; g.fillRect(36, 366, 388, 80); drawT(ptext('QUEST', { size: 10, weight: 400, family: 'Press Start 2P', color: C.ivory }), 230, 406, 4);
  OSTEPS.forEach(([lab, ti], i) => { const y = 520 + i * 125, done = t >= ti + 0.3, on = t >= ti, k = sp(t - ti, PLAYFUL);
    g.fillStyle = C.ink; g.fillRect(340, y - 30, 60, 60); g.fillStyle = on ? (done ? C.pink : '#F7C948') : C.lavL; g.fillRect(346, y - 24, 48, 48);
    if (done) drawT(ptext('✓', { size: 14, color: C.ivory }), 370, y, 3);
    const latin = lab === 'karaduo.com', tc = ptext(lab, { size: latin ? 9 : 12, weight: latin ? 700 : 900, family: latin ? 'Montserrat' : 'Cairo', color: on ? C.mauve : C.lavD });
    const sc = Math.min(3.2, 270 / tc.width); drawT(tc, 320 - tc.width * sc / 2, y, sc, { sc: on ? 0.9 + 0.1 * k : 0.9 }); });
  g.restore();
  if (t > 27.40) { const k = sp(t - 27.40, SNAPPY); g.save(); g.translate(540, 1560); g.scale(k, k); pill(0, 0, 900, 120, C.pink);
    drawT(ptext('الرياض خلال يومين · الخليج خلال ٥ أيام', { size: 16, color: C.ivory }), 0, -2, 3.0); g.restore(); }
}

function sEnd(t) {
  space(t, C.mauveDD); rays(540, 760, 1300, t, 0.3 * clamp((t - 29.65) * 3));
  drawT(ptext('COLLECTION COMPLETE', { size: 10, weight: 400, family: 'Press Start 2P', color: '#F7C948', outline: C.ink }), 540, 250, 4.2, { sc: sp(t - 29.70, SNAPPY) });
  counter(57, 540, 350, 4.2, sp(t - 29.85, PLAYFUL));
  g.fillStyle = C.ink; g.beginPath(); g.ellipse(540, 1060, 330, 70, 0, 0, Math.PI * 2); g.fill(); g.fillStyle = C.mauve; g.beginPath(); g.ellipse(540, 1050, 320, 62, 0, 0, Math.PI * 2); g.fill();
  const bk = sp(t - 29.80, [150, 15]); photo('bago', 540, 790 + Math.sin(t * 2) * 8, 520 * bk);
  for (let i = 0; i < 6; i++) { const a = t * 1.5 + i * Math.PI / 3; drawSpr(sparkle(i % 2 ? C.pink : '#F7C948'), 540 + Math.cos(a) * 360, 790 + Math.sin(a) * 300, 6 * clamp((t - 30.05) * 3)); }
  const nk = sp(t - 30.15, SNAPPY); if (nk > 0) text('شنطة بيوتي ارتست المتكاملة', 540, 1180 + (1 - nk) * 30, { size: 62, weight: 900, color: C.ivory, alpha: clamp(nk * 3), maxW: 960 });
  const lk = sp(t - 32.71, HEAVY); if (lk > 0) { const L = IMG.logoW, w = 420 * (0.85 + 0.15 * lk), h = w * L.height / L.width; g.save(); g.globalAlpha = clamp(lk * 3); g.drawImage(L, 540 - w / 2, 1300 - h / 2, w, h); g.restore(); }
  { const words = [['صُنع', 33.88], ['ليعتني', 34.40], ['بجمالك', 34.95]], gap = 20;
    g.save(); g.font = '800 58px "Cairo"'; const ws = words.map(([w]) => g.measureText(w).width); g.restore();
    let x = 540 + (ws.reduce((a, b) => a + b, 0) + gap * (ws.length - 1)) / 2;
    words.forEach(([w, ti], i) => { const k = sp(t - ti, SNAPPY); if (k > 0) text(w, x - ws[i] / 2, 1410 + (1 - k) * 30, { size: 58, color: C.lavL, alpha: clamp(k * 3) }); x -= ws[i] + gap; }); }
  const bt = sp(t - 36.20, SNAPPY), press = t > 37.10 ? 1 - 0.07 * Math.exp(-(t - 37.10) * 10) * Math.sin(Math.min(Math.PI, (t - 37.10) * 18)) : 1;
  if (bt > 0) { g.save(); g.translate(540, 1580); g.scale(bt * press, bt * press); pill(0, 0, 680, 130, C.pink); text('اطلبيها من karaduo.com', 0, -4, { size: 46, weight: 800 }); g.restore(); }
  const uk = sp(t - 36.45, DEFAULT); if (uk > 0) { g.save(); g.globalAlpha = clamp(uk * 2); drawT(ptext('البكجات ← شنطة بيوتي ارتست المتكاملة', { size: 13, color: C.lavL }), 540, 1710, 3, {}); g.restore(); }
  if (t > 36.60) { const mk = easeOut((t - 36.60) / 0.45); drawSpr(hand(), lerp(1000, 780, mk), lerp(1850, 1592, mk), 7, 0.2, 0.05); }
  if (t > 37.12 && t < 37.60) { const d = t - 37.12; g.strokeStyle = C.ivory; g.lineWidth = 8 * (1 - d / 0.48); g.beginPath(); g.arc(797, 1597, 30 + d * 260, 0, Math.PI * 2); g.stroke(); }
}

const SCENES = [[0, 3.6, sOpen], [3.6, 6.3, sFill], [6.3, 13.9, sCats], [13.9, 18.3, sBag], [18.3, 22.4, sWho], [22.4, 29.4, sOrder], [29.4, 38.41, sEnd]];
const WIPES = [[6.3, C.lav], [13.9, C.mauveDD], [18.3, C.pink], [22.4, C.lavL], [29.4, C.mauveDD]];

function draw(t) {
  g.setTransform(1, 0, 0, 1, 0, 0); g.imageSmoothingEnabled = true;
  const [sx, sy] = shake(t);
  g.save(); g.translate(sx, sy);
  for (const [a, b, fn] of SCENES) if (t >= a && t < b) fn(t);
  drawHost(t);
  g.restore();
  for (const [tc, col] of WIPES) blockWipe(t, tc, col);
}

window.__ready = false;
window.seek = (t) => { draw(t); return true; };
(async () => {
  await Promise.all([loadImg('logo', 'assets/logo.webp'), loadImg('bagc', 'assets/bagc.png'), loadImg('bago', 'assets/bago.png'), loadImg('wheel', 'assets/wheel.png'), loadImg('o_home', 'assets/order/01_home.png'), loadImg('o_bundles', 'assets/order/02_bundles.png'), loadImg('o_product', 'assets/order/03_product.png'), loadImg('o_add', 'assets/order/04_add.png'),
    ...PRODS.map((id) => loadImg(id, `assets/prod/${id}.png`)), loadImg('tube_gold', 'assets/prod/tube_gold.png'),
    loadImg('av_bust', 'assets/avatar/bust.png'), ...FACES5.map((f) => loadImg('av_face_' + f, `assets/avatar/face_${f}.png`))]);
  IMG.logoW = tint(IMG.logo, C.ivory);
  await Promise.all(['900 20px Cairo', '800 20px Cairo', '700 20px Cairo', '20px "Press Start 2P"', '500 20px Montserrat', '600 20px Montserrat', '700 20px Montserrat'].map((f) => document.fonts.load(f, 'abcأب٠')));
  await document.fonts.ready;
  window.__ready = true; draw(0);
  if (!navigator.webdriver) { const t0 = performance.now(); (function loop() { draw(((performance.now() - t0) / 1000) % DUR); requestAnimationFrame(loop); })(); }
})();
</script>
